# Copy to .env for local development only. Never commit the real .env file.
# In production (Render), set these as environment variables in the dashboard instead.

# Your Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# A secret you make up yourself (e.g. a long random string). The iOS Shortcut
# sends this back as "Authorization: Bearer <API_SECRET>" so random people
# can't hit your endpoint and spend your Anthropic credits. Also gates
# /spotify/login (as a ?secret= query param) so strangers can't connect their
# own Spotify account to your server.
API_SECRET=

# A separate secret (generate the same way, e.g. `openssl rand -hex 24`) used
# only by the weekly QStash schedule (https://console.upstash.com/qstash) to
# call POST /spotify/sync, set as its "Authorization: Bearer <CRON_SECRET>"
# header. Kept separate from API_SECRET so a leak there can't be used against
# /parse-schedule.
CRON_SECRET=

# Spotify app credentials — create an app at
# https://developer.spotify.com/dashboard, then register both
# http://localhost:3000/spotify/callback (for local dev) and
# https://<your-render-url>/spotify/callback (for production) as Redirect URIs.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must exactly match one of the Redirect URIs registered above — use the
# localhost one for local dev, the Render one in production.
SPOTIFY_REDIRECT_URI=http://localhost:3000/spotify/callback

# Upstash Redis (https://console.upstash.com) — create a free Redis database,
# then copy the REST API URL and token from its dashboard. Stores your Spotify
# refresh token and monthly playlist state. Use the same database for local
# dev and production so you only need to connect Spotify once.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# TickTick app credentials — create an app at
# https://developer.ticktick.com/manage, then register both
# http://localhost:3000/ticktick/callback (for local dev) and
# https://<your-render-url>/ticktick/callback (for production) as the
# Redirect URI.
TICKTICK_CLIENT_ID=
TICKTICK_CLIENT_SECRET=
# Must exactly match the Redirect URI registered above — use the localhost
# one for local dev, the Render one in production.
TICKTICK_REDIRECT_URI=http://localhost:3000/ticktick/callback
# The TickTick list (project) the "Check monthly playlist" task gets added
# to. Find it after connecting your account (see README) by hitting
# GET /ticktick/projects?secret=<API_SECRET> and copying the id of the list
# you want.
TICKTICK_PROJECT_ID=

# Discord bot credentials — create an application + bot at
# https://discord.com/developers/applications, then copy its token here.
# The bot must share at least one server with you (invite it to any server
# you're in, even a private one you make just for this) — Discord won't let
# a bot open a DM otherwise.
DISCORD_BOT_TOKEN=
# Your Discord account's user ID (enable Developer Mode in Discord settings,
# then right-click your own name/avatar and "Copy User ID"). The bot sends
# DMs to this ID.
DISCORD_USER_ID=
# The application's public key, from the same page as DISCORD_BOT_TOKEN.
# Verifies that button-click webhooks (e.g. the TickTick reminder toggle)
# really came from Discord. Required only once you set an Interactions
# Endpoint URL on the application — see README.
DISCORD_PUBLIC_KEY=
