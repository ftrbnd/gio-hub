{
	"name": "gio-hub-server",
	"version": "1.0.0",
	"description": "A personal-app server: parses work schedule photos (ADP screenshot or printed sheet) into calendar shifts using Claude's vision model, and keeps a monthly Spotify playlist stocked with your weekly top tracks.",
	"main": "dist/index.js",
	"packageManager": "pnpm@11.24.0",
	"scripts": {
		"build": "pnpm run build:client && tsc && tsc-alias",
		"build:client": "pnpm --filter gio-hub-admin build",
		"start": "node dist/index.js",
		"dev": "concurrently -k -n server,client -c blue,green \"pnpm run dev:server\" \"pnpm run dev:client\"",
		"dev:mfp": "concurrently -k -n server,client,mfp -c blue,green,magenta \"pnpm run dev:server\" \"pnpm run dev:client\" \"pnpm run mfp-worker\"",
		"dev:server": "tsx watch src/index.ts",
		"dev:client": "pnpm --filter gio-hub-admin dev",
		"mfp-worker": "pnpm --filter gio-hub-mfp-worker start",
		"mfp-login": "pnpm --filter gio-hub-mfp-worker run login",
		"mfp-chrome": "pnpm --filter gio-hub-mfp-worker run chrome"
	},
	"engines": {
		"node": ">=18"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.115.0",
		"@upstash/redis": "^1.38.2",
		"cloudinary": "^2.10.1",
		"cookie-parser": "^1.4.7",
		"discord-interactions": "^4.4.0",
		"discord.js": "^14.27.0",
		"dotenv": "^17.4.2",
		"express": "^4.21.1",
		"multer": "^2.2.0",
		"sharp": "^0.35.3",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/cookie-parser": "^1.4.10",
		"@types/express": "^5.0.6",
		"@types/multer": "^2.2.0",
		"@types/node": "^26.1.1",
		"@types/sharp": "^0.31.1",
		"concurrently": "^10.0.5",
		"tsc-alias": "^1.9.1",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2"
	}
}
